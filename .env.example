# Beispiel-Konfiguration – kopiere diese Datei nach `.env` und trage deine Werte ein.
# `.env` ist per .gitignore ausgeschlossen, damit der Secret-Key nicht ins Repo gelangt.

# HTTP-Port und Datenpfad (optional, hier die Defaults)
# PORT=8080
# DATA_FILE=/data/nutella.json

# --- Foto-Erkennung (optional) via Microsoft Foundry / Azure OpenAI Vision ---
# Endpoint deiner Foundry-/Azure-OpenAI-Ressource
AZURE_VISION_ENDPOINT=https://<deine-ressource>.openai.azure.com
# Secret/API-Key (NICHT committen!)
AZURE_VISION_KEY=dein-geheimer-key
# Deployment-/Modellname des Vision-fähigen Modells (z. B. gpt-4o)
AZURE_VISION_MODEL=gpt-4o
# API-Version (optional, Default: 2024-08-01-preview)
AZURE_VISION_API_VERSION=2024-08-01-preview
