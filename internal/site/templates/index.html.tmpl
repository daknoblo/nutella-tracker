<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ .Title }}</title>
  <meta name="description" content="{{ .Description }}" />
  <link rel="stylesheet" href="assets/site.css" />
  <link rel="icon"
    href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect x='9' y='3' width='14' height='4' rx='1' fill='%23e8e8e8'/><rect x='10' y='7' width='12' height='3' fill='%23c0392b'/><path d='M8 10h16v17a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2z' fill='%236d4326'/><rect x='11' y='14' width='10' height='9' rx='1' fill='%23f5f1ec'/><text x='16' y='21' font-size='6' text-anchor='middle' fill='%236d4326' font-family='sans-serif' font-weight='bold'>N</text></svg>" />
</head>

<body>
  <header class="hero">
    <h1>
      <svg class="logo" viewBox="0 0 32 32" aria-hidden="true">
        <rect x="9" y="3" width="14" height="4" rx="1" fill="#e8e8e8" />
        <rect x="10" y="7" width="12" height="3" fill="#c0392b" />
        <path d="M8 10h16v17a2 2 0 0 1-2 2H10a2 2 0 0 1-2-2z" fill="#fff" />
        <rect x="11" y="13" width="10" height="11" rx="1" fill="#6d4326" />
        <text x="16" y="21" font-size="7" text-anchor="middle" fill="#f5f1ec" font-family="sans-serif"
          font-weight="bold">N</text>
      </svg>
      {{ .Title }}
    </h1>
    <p>{{ .Description }}</p>
    <nav class="cta">
      <a class="primary" href="demo/">Live-Demo öffnen</a>
      <a href="{{ .RepoURL }}">Quellcode auf GitHub</a>
      <a href="#screenshots">Screenshots</a>
    </nav>
  </header>

  <main>
    <section class="panel">
      {{ .Readme }}
    </section>

    <h2 id="screenshots">Screenshots</h2>
    <p>Automatisch aus der <a href="demo/">Live-Demo</a> erzeugt – jede Sektion der Oberfläche mit Beispieldaten.</p>
    <div class="gallery">
      {{ range .Shots }}
      <figure>
        <a href="assets/screenshots/{{ .Name }}.png">
          <img src="assets/screenshots/{{ .Name }}.png" alt="{{ .Title }}" loading="lazy" />
        </a>
        <figcaption>{{ .Title }}</figcaption>
      </figure>
      {{ end }}
    </div>
  </main>

  <footer>
    Automatisch generiert am {{ .Generated }} ·
    <a href="{{ .RepoURL }}">{{ .RepoURL }}</a>
  </footer>
</body>

</html>
